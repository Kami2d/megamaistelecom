# Configurações opcionais para o deploy.
# Copie para .env.local (uso local) ou defina em Project Settings > Environment Variables no Vercel.
# Se vazias, o site usa os valores de src/data/site.ts (obtidos do MVP de referência).

# Número do WhatsApp comercial em formato internacional, sem "+" nem espaços.
VITE_WHATSAPP_PHONE=5598992165127

# URL da área do cliente. Use um caminho relativo (ex.: #contato) ou uma URL absoluta.
VITE_CUSTOMER_PORTAL_URL=https://meganettelecom.sgp.net.br/accounts/central/login?next=/central/home/

# Link do aplicativo na Google Play (usado pelo botão/imagem da seção do app).
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.appnex.megamaistelecom

# Central de Status: quando definido, o painel consulta apenas este backend
# (contrato documentado no README). Vazio = consulta direta às fontes com CORS.
VITE_STATUS_API_URL=

# Intervalo do polling e TTL do cache, em milissegundos. Padrão: 180000 (3 min).
VITE_STATUS_POLL_INTERVAL_MS=180000
VITE_STATUS_CACHE_TTL_MS=180000

# Timeout por requisição externa, em milissegundos. Padrão: 8000.
VITE_STATUS_REQUEST_TIMEOUT_MS=8000

# Downdetector (opcional): URL do proxy local que guarda as credenciais da API.
# Com VITE_STATUS_API_URL vazio, o painel usa as fontes com CORS e acrescenta
# os dados do Downdetector vindos deste proxy.
VITE_DOWNDETECTOR_API_URL=http://localhost:8787/api/downdetector

# Proxy backend (server/downdetector.mjs). NUNCA use essas credenciais no front.
# A API exige assinatura Enterprise: https://downdetectorapi.com
DOWNDETECTOR_CLIENT_ID=
DOWNDETECTOR_CLIENT_SECRET=
DOWNDETECTOR_COUNTRY=BR
DOWNDETECTOR_CACHE_TTL_MS=180000
DOWNDETECTOR_CONCURRENCY=4
DOWNDETECTOR_REQUEST_TIMEOUT_MS=10000
DOWNDETECTOR_CORS_ORIGIN=*
PORT=8787

# Speedtest Provider Enrichment API (Ookla) — endpoint /v1/subscriber-service.
# A OOKLA CHAMA A GENTE: configure ao menos UM esquema de autenticação.
# Use valores longos e aleatórios; nunca exponha estes dados no front (sem VITE_).
ENRICHMENT_BEARER_TOKEN=
# OAuth2 também usa Bearer; defina separadamente se a Ookla fornecer outro token.
ENRICHMENT_OAUTH2_TOKEN=
ENRICHMENT_BASIC_USER=
ENRICHMENT_BASIC_PASSWORD=
ENRICHMENT_API_KEY=
# Onde a Ookla envia a chave: header (padrão), query ou cookie.
ENRICHMENT_API_KEY_NAME=X-API-Key
ENRICHMENT_API_KEY_IN=header

# Base local de assinantes (copie server/subscribers.example.json). Sem arquivo,
# o endpoint responde 404 — nenhum dado é inventado.
ENRICHMENT_SUBSCRIBERS_FILE=
# Opcional: em vez do arquivo local, consultar o CRM/billing da operadora.
# Deve aceitar ?ipv4=&ipv6=&port= e devolver o objeto "service".
ENRICHMENT_SUBSCRIBER_UPSTREAM_URL=
ENRICHMENT_UPSTREAM_TOKEN=
ENRICHMENT_REQUEST_TIMEOUT_MS=5000
